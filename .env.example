# Projex configuration — copy relevant values into your site_config.json via
#   bench --site <site> set-config <key> <value>
# NEVER commit real secrets. The app runs fully without any of these set;
# AI features simply stay disabled and hidden.

# AI provider abstraction (optional). When unset, all AI surfaces are hidden.
# projex_ai_provider=openai        # or: anthropic, etc.
# projex_ai_api_key=sk-xxxxxxxx    # provider API key (keep secret)

# ERPNext integration is auto-detected: if the `erpnext` app is installed,
# the Customer/Project link fields and time-logging are enabled automatically.
# No configuration needed.
